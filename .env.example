# Окружение: local | staging | production. По умолчанию local.
APP_ENV=

# Адрес сайта без слеша в конце. Локально по умолчанию http://localhost:3000.
# В staging и production обязателен, только https.
SITE_URL=

# PostgreSQL. Локально – после `pnpm db:up`:
# postgres://puzzleup:puzzleup@127.0.0.1:5432/puzzleup
# В staging и production обязателен.
DATABASE_URL=

# Telegram-бот: все пять сразу или ни одной (тогда бот выключен).
# В staging и production обязательны.
# Токен от @BotFather.
TELEGRAM_BOT_TOKEN=
# 32–256 символов A-Z, a-z, 0-9, _ и -: `openssl rand -hex 32`.
TELEGRAM_WEBHOOK_SECRET=
# Общий чат репетиторов, у групп id отрицательный: -100…
TELEGRAM_LEADS_CHAT_ID=
# Личка Андрея для предупреждений (его Telegram ID).
TELEGRAM_ALERT_CHAT_ID=
# JSON: Telegram ID репетитора → его id из content/tutors.
# {"123456789":"t-andrei","987654321":"t-maxim"}
TELEGRAM_TUTORS=

GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON= 