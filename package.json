{
  "name": "puzzleup-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm content:check && next build && pnpm worker:build",
    "start": "node scripts/start-standalone.ts",
    "lint": "eslint . && tsx scripts/copy-lint.ts",
    "lint:copy": "tsx scripts/copy-lint.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit --project browser",
    "test:watch": "vitest --project unit --project browser",
    "test:int": "vitest run --project int",
    "content:check": "tsx scripts/content-check.ts",
    "db:up": "docker compose -f docker/compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker/compose.dev.yml down",
    "db:generate": "NODE_OPTIONS=--conditions=react-server drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/db-migrate.ts",
    "bot:set-webhook": "tsx --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/bot-set-webhook.ts",
    "bot:poll": "tsx --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/bot-poll.ts",
    "e2e": "playwright test",
    "worker:dev": "tsx watch --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=.env.local worker/index.ts",
    "worker:build": "tsup",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@conform-to/react": "1.21.3",
    "@conform-to/zod": "1.21.3",
    "@content-collections/mdx": "0.2.2",
    "drizzle-orm": "0.45.4",
    "grammy": "1.48.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@content-collections/core": "0.15.3",
    "@content-collections/next": "0.2.11",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@testcontainers/postgresql": "12.2.2",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser": "5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "lefthook": "2.2.2",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0",
    "vitest-browser-react": "2.3.0"
  }
}
